# =============================================================================
# NBP Performance Management System — Environment Template
# =============================================================================
# Copy this file to .env.production (or configure in Coolify Secrets)
# NEVER commit actual values to source control.
# All secrets must be managed via Coolify Protected Variables or equivalent.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ─── Database ────────────────────────────────────────────────────────────────
# Production: external SQL Server instance (never expose port publicly)
ConnectionStrings__DefaultConnection=Server=YOUR_SQL_SERVER_HOST;Database=NbpPmsDb;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=False;Encrypt=True;

# ─── ASP.NET Core Identity / Auth ────────────────────────────────────────────
# Anti-forgery and data protection keys
DataProtection__KeyPath=/app/keys
Identity__RequireConfirmedAccount=false
Identity__LockoutMaxFailedAttempts=5
Identity__LockoutDurationMinutes=15
Identity__PasswordRequireUppercase=true
Identity__PasswordRequireDigit=true
Identity__PasswordRequireNonAlphanumeric=true
Identity__PasswordMinLength=10
Identity__SessionTimeoutMinutes=60

# ─── Cookie Settings ─────────────────────────────────────────────────────────
Cookie__Domain=YOUR_APP_DOMAIN
Cookie__SameSite=Strict
Cookie__SecurePolicy=Always

# ─── Field-Level Encryption (AES-256-GCM) ────────────────────────────────────
# PILOT: Injected master key (Base64-encoded 32-byte key)
# PRODUCTION: Replace with KMS key reference (Azure Key Vault / HashiCorp Vault)
Encryption__Provider=Environment
Encryption__MasterKeyBase64=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
Encryption__KeyVersion=1

# ─── Hangfire Background Jobs ─────────────────────────────────────────────────
Hangfire__Dashboard__Enabled=false
Hangfire__Dashboard__Username=REPLACE_WITH_HANGFIRE_ADMIN_USERNAME
Hangfire__Dashboard__Password=REPLACE_WITH_HANGFIRE_ADMIN_PASSWORD
Hangfire__WorkerCount=5

# ─── Email / SMTP (MailKit) ──────────────────────────────────────────────────
Smtp__Host=YOUR_SMTP_HOST
Smtp__Port=587
Smtp__UseSsl=true
Smtp__Username=YOUR_SMTP_USERNAME
Smtp__Password=YOUR_SMTP_PASSWORD
Smtp__SenderName=NBP Performance Management System
Smtp__SenderEmail=pms@nbp.com.pk
Smtp__ReplyToEmail=pms-noreply@nbp.com.pk

# ─── Application URLs ────────────────────────────────────────────────────────
App__BaseUrl=https://YOUR_APP_DOMAIN
App__FrontendUrl=https://YOUR_APP_DOMAIN

# ─── Redis (Optional — required for scale-out) ───────────────────────────────
# Redis__ConnectionString=YOUR_REDIS_HOST:6379,password=YOUR_REDIS_PASSWORD

# ─── Logging (Serilog) ───────────────────────────────────────────────────────
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__System=Warning
# Set to External to ship logs to Seq/Elastic/etc
Serilog__WriteTo__0__Name=Console

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RateLimiting__Login__PermitLimit=5
RateLimiting__Login__WindowSeconds=900
RateLimiting__Api__PermitLimit=100
RateLimiting__Api__WindowSeconds=60

# ─── CORS ────────────────────────────────────────────────────────────────────
Cors__AllowedOrigins=https://YOUR_APP_DOMAIN

# ─── File Storage ────────────────────────────────────────────────────────────
Storage__Provider=Local
Storage__BasePath=/app/uploads
Storage__MaxFileSizeBytes=20971520
# Storage__AzureBlobConnectionString=REPLACE_FOR_AZURE_BLOB

# ─── Health Checks ───────────────────────────────────────────────────────────
HealthChecks__DetailedErrors=false
